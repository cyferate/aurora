# =============================================
# AURORA — Environment Configuration Template
# Copy this to .env and fill in your values
# =============================================

# --- Harness Ports ---
HARNESS_PORT=20128
PROXY_PORT=8082
DASHBOARD_PORT=5173
WS_PORT=8083

# --- OpenRouter (Free tier — sign up at openrouter.ai) ---
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# --- Nvidia NIM (Free tier — sign up at build.nvidia.com) ---
NVIDIA_API_KEY=nvapi-your_key_here

# --- Groq (Free tier — sign up at groq.com) ---
GROQ_API_KEY=gsk_your_key_here

# --- Google Gemini (Free tier — sign up at aistudio.google.com) ---
GEMINI_API_KEY=AIzaSy_your_key_here

# --- Ollama (Local — no key needed) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- OmniRush Integration ---
OMNIRUSH_SERVER_PORT=8787
OMNIRUSH_URL=http://localhost:8787
OMNIRUSH_AUTO_START=false

# --- Default Provider Chain (comma-separated, in priority order) ---
# Options: openrouter, nvidia, groq, gemini, ollama, omnirush
DEFAULT_PROVIDER_CHAIN=openrouter,nvidia,groq,gemini,ollama

# --- Default Models ---
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-r1:free
NVIDIA_DEFAULT_MODEL=meta/llama-3.1-405b-instruct
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GEMINI_DEFAULT_MODEL=gemini-2.0-flash-exp
OLLAMA_DEFAULT_MODEL=llama3.2

# --- Token Saver ---
TOKEN_SAVER_ENABLED=true
TOKEN_SAVER_MAX_TOOL_LINES=200
TOKEN_SAVER_MAX_DIFF_LINES=200

# --- Mixture of Agents ---
MOA_ENABLED=false
MOA_GENERATOR=openrouter
MOA_CRITIC=groq
MOA_OPTIMIZER=gemini
MOA_SYNTHESIZER=ollama

# --- Key Rotation ---
KEY_COOLDOWN_SECONDS=300
KEY_ROTATION_STRATEGY=round_robin

# --- AURORA Dashboard ---
AURORA_THEME=cyberpunk
AURORA_AUTO_OPEN_BROWSER=true

